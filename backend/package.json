{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "server.ts",
  "type": "module",
  "scripts": {
    "dev": "npx tsx watch server.ts",
    "logs": "tsx watch logs/show.logs.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "frontend": "cd ../frontend && npm run dev",
    "app": "cd ../nexus-app && npm run start",
    "local-be": "cd ../local-be-v2 && dotnet watch -- --service",
    "frontend:seperate": "start cmd /k \"cd /d D:/coding/projects/next/nexus_v2/frontend && npm run dev\"",
    "backend:seperate": "start cmd /k \"cd D:/coding/Projects/Next/nexus_v2/backend && npm run dev:server\"",
    "LocalBE:seperate": "powershell -Command \"Start-Process cmd -ArgumentList '/k cd D:/coding/Projects/Next/nexus_v2/local-be-v2 && dotnet watch -- --service' -Verb RunAs\"",
    "all": "concurrently -n \"BE,FE\" \"npm run dev:server\" \"npm run frontend\"",
    "all:seperate": "npm run frontend:seperate && npm run backend:seperate && npm run LocalBE:seperate",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "@google/genai": "^2.22.0",
    "axios": "^1.18.1",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "https-proxy-agent": "^9.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.1",
    "screenshot-desktop": "^1.15.4",
    "ts-node": "^10.9.2",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.2.0",
    "@types/readline-sync": "^1.4.8",
    "@types/screenshot-desktop": "^1.15.0",
    "@types/ws": "^8.18.1",
    "concurrently": "^10.0.3",
    "nodemon": "^1.14.10",
    "readline-sync": "^1.4.10",
    "tsx": "^4.23.11",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "@google/genai@2.22.0": true
  }
}
