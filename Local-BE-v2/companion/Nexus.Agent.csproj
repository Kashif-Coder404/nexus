<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <AssemblyName>nexus</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>WinExe</OutputType>
    <Version>2.6.2</Version>
    <AssemblyVersion>2.6.2.0</AssemblyVersion>
    <FileVersion>2.6.2.0</FileVersion>
    <DefaultItemExcludes>$(DefaultItemExcludes);dist\**;SetupPage\**</DefaultItemExcludes>
  </PropertyGroup>


  <ItemGroup>
    <!-- Hardware Monitoring (CPU/GPU temps, fans, wattage) -->
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.4" />
    <PackageReference Include="Porta.Pty" Version="1.0.7" />

    <!-- Native Screen Capture (GDI+) -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.8" />

    <!-- Allows running as a native Windows Service -->
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <None Update="setupPage.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <EmbeddedResource Include="setupPage.html" />
  </ItemGroup>

</Project>